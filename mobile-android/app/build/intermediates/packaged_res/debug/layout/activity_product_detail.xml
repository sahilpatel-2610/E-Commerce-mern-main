<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBarDetail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_dark"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackDetail"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_ios"
            app:tint="@color/gold_light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="PRODUCT DETAILS"
            android:textColor="@color/gold_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnCartDetail"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_icon">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shopping_bag"
                app:tint="@color/gold_light" />

            <TextView
                android:id="@+id/tvDetailCartBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="-2dp"
                android:layout_marginTop="-2dp"
                android:background="@drawable/bg_circle_gold"
                android:gravity="center"
                android:textColor="@color/text_black"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomActionDetail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarDetail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Primary Image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp">

                <ImageView
                    android:id="@+id/ivDetailPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvDetailDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_badge_discount"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="20% OFF"
                    android:textColor="@color/gold_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Image Thumbnails Carousel (when product has > 1 image) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetailThumbnails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetailBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="VRAJ CREATION"
                    android:textColor="@color/gold_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Silk Zari Embroidery Kurta"
                    android:textColor="@color/text_white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Price Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="₹2,499"
                        android:textColor="@color/gold_light"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailOldPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="monospace"
                        android:text="₹3,199"
                        android:textColor="@color/text_gray_dark"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gold"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_star_filled"
                            app:tint="@color/gold_light" />

                        <TextView
                            android:id="@+id/tvDetailRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="5.0 (24 Reviews)"
                            android:textColor="@color/gold_light"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/border_dark" />

                <!-- Size Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="SELECT SIZE"
                    android:textColor="@color/text_white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutSizes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sizeS"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="@color/text_black"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sizeM"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="M"
                        android:textColor="@color/text_gray_light"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sizeL"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="L"
                        android:textColor="@color/text_gray_light"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sizeXL"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="XL"
                        android:textColor="@color/text_gray_light"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sizeXXL"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="XXL"
                        android:textColor="@color/text_gray_light"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/border_dark" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="PRODUCT DESCRIPTION"
                    android:textColor="@color/text_white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3.5dp"
                    android:text="Handcrafted with pure premium silk yarns and detailed embroidery, perfect for wedding festivities and gala celebrations."
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <!-- Related Products Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:letterSpacing="0.08"
                    android:text="YOU MAY ALSO ADORE"
                    android:textColor="@color/gold_light"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRelatedProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionDetail"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/surface_dark"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnAddToCart"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gold_outline_btn"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="ADD TO BAG"
            android:textColor="@color/gold_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnBuyNow"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gold_gradient_btn"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="BUY NOW"
            android:textColor="@color/text_black"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
