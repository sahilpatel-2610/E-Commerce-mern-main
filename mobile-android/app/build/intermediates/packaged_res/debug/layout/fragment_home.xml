<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Luxury Header Bar (Same to Same as Flutter AppBar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface_dark"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Brand Logo on Left -->
        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="128dp"
            android:layout_height="38dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/app_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Luxury Header Actions Pill (Same to Same as Flutter LuxuryHeaderActions) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_elevated_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="5dp"
            android:paddingVertical="3dp">

            <!-- 1. Search Button -->
            <FrameLayout
                android:id="@+id/btnHeaderSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_circle_icon">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_header_search"
                    app:tint="@color/text_white" />

            </FrameLayout>

            <!-- 2. Notification Bell with Live Red Badge -->
            <FrameLayout
                android:id="@+id/btnHeaderNotifications"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_circle_icon"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_header_bell"
                    app:tint="@color/text_white" />

                <TextView
                    android:id="@+id/tvHeaderNotifBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="-2dp"
                    android:layout_marginTop="-2dp"
                    android:background="@drawable/bg_circle_gold"
                    android:gravity="center"
                    android:textColor="@color/text_black"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- 3. Account / Profile Button -->
            <FrameLayout
                android:id="@+id/btnHeaderAccount"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_circle_icon">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_header_account"
                    app:tint="@color/text_white" />

            </FrameLayout>

            <!-- 4. Cart Button with Live Item Counter Badge -->
            <FrameLayout
                android:id="@+id/btnHeaderCart"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_icon"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_header_cart"
                    app:tint="@color/text_white" />

                <TextView
                    android:id="@+id/tvHeaderCartBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="-2dp"
                    android:layout_marginTop="-2dp"
                    android:background="@drawable/bg_circle_gold"
                    android:gravity="center"
                    android:textColor="@color/text_black"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- 1. HERO SHOWCASE (Clean, Full-Screen Video/Image Carousel) -->
                <FrameLayout
                    android:id="@+id/frameHeroBanner"
                    android:layout_width="match_parent"
                    android:layout_height="520dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="6dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpHomeBanners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </FrameLayout>

                <!-- 2. SECTION: LATEST COLLECTION (Positioned cleanly right above bottom nav matching Photo 2) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LATEST "
                            android:textColor="@color/gold_primary"
                            android:textSize="20sp"
                            android:letterSpacing="0.06"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COLLECTION"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:letterSpacing="0.06"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="30dp"
                            android:layout_height="2dp"
                            android:layout_marginStart="8dp"
                            android:background="@color/gold_primary" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Discover our latest fashion collection featuring premium fabrics, trending styles, and elegant designs for every occasion."
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Latest Collections Line 1 (Independent Horizontal Row) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLatestLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp" />

                <!-- Latest Collections Line 2 (Independent Horizontal Row) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLatestLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp" />

                <!-- 3. SECTION: BEST SELLER (1 Row Horizontal Scroll) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BEST "
                            android:textColor="@color/gold_primary"
                            android:textSize="20sp"
                            android:letterSpacing="0.06"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SELLER"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:letterSpacing="0.06"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="30dp"
                            android:layout_height="2dp"
                            android:layout_marginStart="8dp"
                            android:background="@color/gold_primary" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Explore our top-selling fashion picks, curated for unmatched quality, style, and everyday comfort."
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBestSellers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp" />

                <!-- 4. SECTION: OUR POLICY (4 Standalone Luxury Cards) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical">

                    <!-- Policy Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Card 1: Easy Exchange -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dark_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔄"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Easy Exchange Policy"
                                android:textColor="@color/gold_light"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Hassle-free size and product exchange on all orders."
                                android:textColor="@color/text_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Card 2: 7 Days Return -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dark_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📅"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="7 Days Return Policy"
                                android:textColor="@color/status_green"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Easy 7-day return guarantee on eligible fashion apparel."
                                android:textColor="@color/text_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Policy Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Card 3: 24/7 Support -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dark_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎧"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="24/7 Dedicated Support"
                                android:textColor="@color/status_blue"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Expert customer assistance &amp; sizing help whenever you need."
                                android:textColor="@color/text_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Card 4: 100% Secure Checkout -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dark_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛡️"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="100% Secure Checkout"
                                android:textColor="@color/gold_light"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Safe &amp; encrypted payments with UPI, Cards &amp; Cash on Delivery."
                                android:textColor="@color/text_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- 5. SECTION: VRAJ CREATION BUSINESS SHOWCASE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_dark_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="✨ APPAREL &amp; CLOTHING"
                        android:textColor="@color/gold_light"
                        android:textSize="11.5sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="👔 Premium Men's Apparel\nManufacturer &amp; Wholesaler"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Badge 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 Surat, Gujarat | Shipping Pan-India 🇮🇳"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Badge 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦 B2B Only. 🚫 No Retail"
                            android:textColor="@color/gold_light"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Badge 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👔 Shirts, T-Shirts, Denim &amp; Trousers"
                            android:textColor="@color/status_green"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnExploreWholesale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_gold_gradient_btn"
                        android:paddingHorizontal="26dp"
                        android:paddingVertical="14dp"
                        android:text="Explore Wholesale Collections →"
                        android:textColor="@color/text_black"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 6. SECTION: VIP DROPS NEWSLETTER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_dark_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_discount"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="✨ VRAJ CREATION EXCLUSIVE"
                        android:textColor="@color/gold_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Never Miss a Drop!"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Subscribe to receive exclusive lookbook releases, seasonal couture updates, and member-only privileges directly in your inbox."
                        android:textColor="@color/text_gray"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp">

                        <EditText
                            android:id="@+id/etNewsletterEmail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Enter your email address"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/text_white"
                            android:textColorHint="@color/text_gray_dark"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnSubscribeNewsletter"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gold_gradient_btn"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"
                            android:text="Subscribe"
                            android:textColor="@color/text_black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 7. SECTION: OFFICIAL ATELIER FOOTER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VRAJ CREATION"
                        android:textColor="@color/gold_primary"
                        android:textSize="15sp"
                        android:letterSpacing="0.12"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Luxury Fashion &amp; Couture"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnScrollToTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_badge_gold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="↑ BACK TO TOP"
                        android:textColor="@color/gold_light"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="© 2026 Vraj Creation • All Rights Reserved"
                        android:textColor="@color/text_gray_dark"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
