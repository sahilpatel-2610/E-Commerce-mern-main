<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_dark_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 1. Top Meta Bar (Order ID + Date + Copy + Payment Badge) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Order ID Chip -->
        <LinearLayout
            android:id="@+id/btnCopyOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_gold"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="ORDER #12345678"
                android:textColor="@color/gold_light"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/gold_light" />

        </LinearLayout>

        <!-- Payment Method Badge -->
        <TextView
            android:id="@+id/tvOrderPaymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="COD"
            android:textColor="@color/gold_light"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_dark" />

    <!-- 2. Item Details & Thumbnail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="86dp"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivOrderProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Luxury Silk Sherwani"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Price & Qty & Size Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOrderPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="₹4,999"
                    android:textColor="@color/gold_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOrderQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Qty: 1"
                    android:textColor="@color/text_gray"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvOrderSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_discount"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="Size: M"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Date -->
            <TextView
                android:id="@+id/tvOrderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Date: 28 Aug, 2026"
                android:textColor="@color/text_gray"
                android:textSize="11.5sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_dark" />

    <!-- 3. Live 4-Stage Visual Stepper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <!-- Node 1: Placed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stepNode1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_badge_gold"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/text_black"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Placed"
                android:textColor="@color/text_white"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:id="@+id/stepDivider1"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:background="@color/gold_primary" />

        <!-- Node 2: Packed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stepNode2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="📦"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Packed"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:id="@+id/stepDivider2"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:background="@color/border_dark" />

        <!-- Node 3: Shipped -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stepNode3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="🚚"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Shipped"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:id="@+id/stepDivider3"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:background="@color/border_dark" />

        <!-- Node 4: Delivered -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stepNode4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="✨"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Delivered"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 4. Bottom Row: Status Badge + Invoice & Track Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvOrderStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_gold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Order Placed"
            android:textColor="@color/gold_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Invoice Button -->
        <LinearLayout
            android:id="@+id/btnOrderInvoice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_invoice"
                app:tint="@color/gold_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Invoice"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Track Button -->
        <LinearLayout
            android:id="@+id/btnOrderTrack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gold_gradient_btn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_my_location"
                app:tint="@color/text_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Track"
                android:textColor="@color/text_black"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
