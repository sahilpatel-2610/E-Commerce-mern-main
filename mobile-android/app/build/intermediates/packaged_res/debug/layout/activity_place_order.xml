<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:id="@+id/topBarPlaceOrder"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_dark"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackPlaceOrder"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_ios"
            app:tint="@color/gold_light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="CHECKOUT &amp; DELIVERY"
            android:textColor="@color/gold_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomActionPlaceOrder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarPlaceOrder">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Address Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_heritage_shipping"
                        app:tint="@color/gold_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.08"
                        android:text="DELIVERY ADDRESS"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/border_dark" />

                <EditText
                    android:id="@+id/etOrderFullName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Full Name"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray_dark"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etOrderEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Email Address (for tracking updates)"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray_dark"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etOrderPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Mobile Phone Number"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray_dark"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etOrderAddress"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top"
                    android:hint="Street Address, House No, Landmark"
                    android:padding="12dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray_dark"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etOrderCity"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="City"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray_dark"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etOrderState"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="State"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray_dark"
                        android:textSize="13sp" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etOrderPincode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="PIN Code"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray_dark"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Payment Method -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dark_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_invoice"
                        app:tint="@color/gold_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.08"
                        android:text="PAYMENT METHOD"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/border_dark" />

                <RadioGroup
                    android:id="@+id/rgPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbCod"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/gold_primary"
                        android:checked="true"
                        android:text="Cash on Delivery (COD)"
                        android:textColor="@color/text_white"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbUpi"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/gold_primary"
                        android:text="UPI / Net Banking (Instant Confirmation)"
                        android:textColor="@color/text_white"
                        android:textSize="13sp" />

                </RadioGroup>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Place Order Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionPlaceOrder"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/surface_dark"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payable Amount"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPlaceOrderTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="₹0"
                android:textColor="@color/gold_light"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnConfirmOrder"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_gold_gradient_btn"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingHorizontal="24dp"
            android:text="PLACE ORDER →"
            android:textColor="@color/text_black"
            android:textSize="12.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
