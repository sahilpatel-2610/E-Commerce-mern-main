<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/bg_dark"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardPreventCornerOverlap="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Background Image Poster (Always loaded first for 0ms visual) -->
        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 2. TextureView-based Full CenterCrop Video (Zero black bars, 100% card filling) -->
        <com.vrajcreation.app.views.LuxuryBannerVideoView
            android:id="@+id/vvBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 3. Bottom Gradient Scrim for crystal clear typography -->
        <View
            android:id="@+id/viewBannerScrim"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim_bottom" />

        <!-- 4. Top Gold Subtitle / Tag Capsule -->
        <TextView
            android:id="@+id/tvBannerTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_glass_gold_pill"
            android:elevation="6dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="EXCLUSIVE"
            android:textColor="@color/gold_light"
            android:textSize="11.5sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <!-- 5. Banner Text Content & Action Button -->
        <LinearLayout
            android:id="@+id/layoutBannerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvBannerTitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="VRAJ CREATION"
                android:textColor="@color/text_white"
                android:textSize="26sp"
                android:letterSpacing="0.02"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBannerTitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="Royal Silk Collection"
                android:textColor="@color/gold_light"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Shop Now Gold CTA Button -->
            <TextView
                android:id="@+id/btnBannerShopNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_gold_gradient_btn"
                android:elevation="4dp"
                android:paddingHorizontal="22dp"
                android:paddingVertical="11dp"
                android:text="SHOP NOW →"
                android:textColor="@color/text_black"
                android:textSize="12.5sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
