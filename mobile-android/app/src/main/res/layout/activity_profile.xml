<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Luxury Header Bar (Matching Flutter MY ACCOUNT AppBar) -->
    <LinearLayout
        android:id="@+id/topBarProfile"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_dark"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_ios"
            app:tint="@color/gold_light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="MY ACCOUNT"
            android:textColor="@color/gold_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnRefreshProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/gold_light" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- 1. Exact MERN Title Component -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MY "
                        android:textColor="@color/gold_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCOUNT"
                        android:textColor="@color/text_white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="2.5dp"
                        android:layout_marginStart="10dp"
                        android:background="@color/gold_primary" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Manage your personal details, profile media, and account security."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="14dp"
                android:background="@color/border_dark" />

            <!-- 2. Exact Underline Tabs: Edit Profile & Change Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Tab 1: Edit Profile -->
                <LinearLayout
                    android:id="@+id/tabEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tvTabEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:textColor="@color/gold_light"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/lineTabEditProfile"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/gold_primary" />

                </LinearLayout>

                <!-- Tab 2: Change Password -->
                <LinearLayout
                    android:id="@+id/tabChangePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:orientation="vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tvTabChangePassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change Password"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/lineTabChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="20dp"
                android:background="@color/border_dark" />

            <!-- ================= TAB 1: EDIT PROFILE FLOW ================= -->
            <LinearLayout
                android:id="@+id/layoutTabEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 190x190 Luxury Choras Square Avatar Card with Camera Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="190dp"
                        android:layout_height="190dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="190dp"
                            android:layout_height="190dp"
                            app:cardBackgroundColor="@color/surface_dark"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="8dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_dark_card">

                                <ImageView
                                    android:id="@+id/ivProfileAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />

                                <TextView
                                    android:id="@+id/tvProfileInitialsLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="V"
                                    android:textColor="@color/gold_light"
                                    android:textSize="64sp"
                                    android:textStyle="bold" />

                            </FrameLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Floating Camera Button -->
                        <FrameLayout
                            android:id="@+id/btnUploadAvatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_gold_gradient_btn"
                            android:elevation="10dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/text_black" />
                        </FrameLayout>

                    </FrameLayout>

                    <!-- Logged in as subtitle -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logged in as "
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvLoggedInEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="patron@vrajcreation.com"
                            android:textColor="@color/gold_light"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Form Fields Card (NAME, EMAIL, PHONE ONLY matching Flutter MERN Card) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_dark_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- NAME Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="NAME"
                        android:textColor="@color/text_gray_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Enter your name"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray_dark"
                        android:textSize="13sp" />

                    <!-- EMAIL Field (Readonly) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.08"
                        android:text="EMAIL"
                        android:textColor="@color/text_gray_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReadonlyEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="patron@vrajcreation.com"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp" />

                    <!-- PHONE Field (10 Digits) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.08"
                        android:text="PHONE (10 DIGITS)"
                        android:textColor="@color/text_gray_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="e.g. 9876543210"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray_dark"
                        android:textSize="13sp" />

                    <!-- SAVE Gradient Button -->
                    <TextView
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_gold_gradient_btn"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:letterSpacing="0.12"
                        android:text="SAVE"
                        android:textColor="@color/text_black"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= TAB 2: CHANGE PASSWORD FLOW ================= -->
            <LinearLayout
                android:id="@+id/layoutTabChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- OLD PASSWORD Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="OLD PASSWORD"
                        android:textColor="@color/text_gray_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etOldPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Enter current password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray_dark"
                        android:textSize="13sp" />

                    <!-- NEW PASSWORD Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.08"
                        android:text="NEW PASSWORD"
                        android:textColor="@color/text_gray_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="At least 6 characters"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray_dark"
                        android:textSize="13sp" />

                    <!-- CONFIRM PASSWORD Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.08"
                        android:text="CONFIRM PASSWORD"
                        android:textColor="@color/text_gray_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Re-enter new password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray_dark"
                        android:textSize="13sp" />

                    <!-- SAVE Password Button -->
                    <TextView
                        android:id="@+id/btnSavePassword"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_gold_gradient_btn"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:letterSpacing="0.12"
                        android:text="SAVE"
                        android:textColor="@color/text_black"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
