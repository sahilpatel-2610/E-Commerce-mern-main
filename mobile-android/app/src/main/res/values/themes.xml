<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VrajCreation" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorSecondary">@color/gold_light</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_gray</item>
        <item name="bottomSheetDialogTheme">@style/LuxuryBottomSheetDialog</item>
        <item name="android:progressBarStyle">@style/LuxuryProgressBar</item>
        <item name="swipeRefreshLayoutProgressSpinnerBackgroundColor">@color/surface_dark</item>
    </style>

    <style name="LuxuryProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/gold_primary</item>
        <item name="android:indeterminateTintMode">src_in</item>
    </style>

    <style name="LuxuryBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/LuxuryBottomSheet</item>
    </style>

    <style name="LuxuryBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_dark</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LuxuryBottomSheet</item>
    </style>

    <style name="ShapeAppearance.LuxuryBottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
</resources>
